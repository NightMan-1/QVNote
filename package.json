{
  "name": "qvnote",
  "version": "2.4.0",
  "private": true,
  "scripts": {
    "serve": "vite",
    "build": "vite build",
    "lint": "eslint --ext .js,.vue src/",
    "preview": "vite preview",
    "postinstall": "mkdir -p public/static/hugerte && cp -r node_modules/hugerte/* public/static/hugerte/ && mkdir -p public/static/hugerte/plugins/paste_from_word && cp node_modules/@pangaeatech/tinymce-paste-from-word-lib/index.js public/static/hugerte/plugins/paste_from_word/plugin.min.js && mkdir -p public/static/ace && cp -r node_modules/ace-builds/src-min-noconflict/* public/static/ace/"
  },
  "dependencies": {
    "@hugerte/hugerte-vue": "^1.0.2",
    "@pangaeatech/tinymce-paste-from-word-lib": "^1.3.2",
    "@unhead/vue": "^3.2.3",
    "ace-builds": "^1.44.0",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "^1.13.1",
    "defuddle": "^0.19.2",
    "echarts": "^5.6.0",
    "hugerte": "^1.0.12",
    "js-beautify": "^1.15.4",
    "markdown-it": "^15.0.0",
    "pinia": "^3.0.4",
    "postcss-import": "^15.1.0",
    "postcss-url": "^10.1.4",
    "prismjs": "^1.30.0",
    "sass": "^1.102.0",
    "tingle.js": "^0.16.0",
    "tippy.js": "^6.3.7",
    "vue": "^3.5.40",
    "vue-echarts": "^7.0.3",
    "vue-i18n": "^11.4.8",
    "vue-multiselect": "^3.5.0",
    "vue-prism-editor": "^2.0.0-alpha.2",
    "vue-router": "^4.6.4",
    "vue-toastification": "^2.0.0-rc.5",
    "vue3-calendar-heatmap": "^2.0.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.5.4",
    "cssnano": "^8.0.2",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "postcss": "^8.5.23",
    "vite": "^6.4.3"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "browser": true,
      "node": true,
      "es2021": true
    },
    "extends": [
      "plugin:vue/vue3-essential"
    ],
    "rules": {
      "indent": [
        "error",
        4
      ],
      "no-tabs": 0,
      "no-mixed-spaces-and-tabs": 0,
      "new-cap": 0,
      "generator-star-spacing": "off",
      "vue/multi-word-component-names": "off"
    },
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    }
  },
  "postcss": {
    "plugins": {
      "postcss-import": {},
      "postcss-url": {},
      "autoprefixer": {},
      "cssnano": {
        "discardComments": {
          "removeAll": true
        },
        "zindex": false
      }
    }
  },
  "browserslist": [
    "last 2 chrome versions",
    "last 2 firefox versions",
    "Firefox ESR",
    "last 2 safari versions",
    "last 2 opera versions",
    "last 2 ios_saf versions",
    "last 2 edge versions",
    "last 2 and_chr versions"
  ]
}
